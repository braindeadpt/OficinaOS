// OficinaOS — Prisma Schema
// Version: 4.0 — Production-ready
// Database: PostgreSQL 17
// All DateTime fields use @db.Timestamptz for timezone safety.
// CHECK constraints, triggers, and partial indexes applied via migrations.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  OWNER
  TECHNICIAN
  FRONT_DESK
}

enum JobStatus {
  INTAKE
  WAITING_FOR_PARTS
  IN_REPAIR
  ON_HOLD
  DONE
  DELIVERED
  RETURNED
  CANCELLED
}

enum PartCategory {
  SCREEN
  BATTERY
  CHARGING_PORT
  CAMERA
  SPEAKER
  MICROPHONE
  MOTHERBOARD
  HOUSING
  BUTTON
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum FaultCategory {
  WORKMANSHIP
  DEFECTIVE_PART
  MISDIAGNOSIS
}

enum ResolutionOutcome {
  REWORK_FREE
  REWORK_PARTIAL_CHARGE
  REFUND_PARTIAL
  REFUND_FULL
}

enum ReturnClaimStatus {
  OPEN
  RESOLVED
}

enum PhotoStage {
  RETURN_INTAKE
  RETURN_RESOLUTION
}

enum RepairCategory {
  HARDWARE
  SOFTWARE
  DIAGNOSTIC
  OTHER
}

enum MovementType {
  PURCHASE
  CONSUMPTION
  RETURN
  ADJUSTMENT
}

enum NotifyChannel {
  WHATSAPP
  IN_APP
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum AuditAction {
  JOB_CREATED
  STATUS_CHANGED
  TECHNICIAN_ASSIGNED
  COST_UPDATED
  PART_ADDED
  PART_REMOVED
  REPAIR_ADDED
  REPAIR_REMOVED
  NOTE_ADDED
  PHOTO_ADDED
  PHOTO_REMOVED
  JOB_UPDATED
  PAYMENT_ADDED
  PAYMENT_DELETED
  WARRANTY_RETURN_CREATED
  NOTIFICATION_SENT
  USER_SIGN_IN
  USER_SIGN_OUT
  USER_CREATED
  PASSWORD_RESET
  API_MUTATION
  QUOTE_SENT
  QUOTE_RESPONDED
}

enum QuoteStatus {
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum AiRole {
  USER
  ASSISTANT
}

enum AiMessageFeedback {
  THUMBS_UP
  THUMBS_DOWN
}

// ─────────────────────────────────────────────
// USER
// password stores Argon2id hash (~97 chars).
// email is required and unique for account identification.
// Auth is username + password via Better Auth.
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  name                String    @default("")
  username            String    @unique
  displayUsername     String?
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  password            String?
  role                Role
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  assignedJobs          Job[]               @relation("AssignedTechnician")
  createdJobs           Job[]               @relation("CreatedBy")
  updatedJobs           Job[]               @relation("UpdatedBy")
  notes                 JobNote[]
  jobParts              JobPart[]
  jobRepairs            JobRepair[]
  paymentsCreated       Payment[]           @relation("PaymentCreatedBy")
  stockMovementsCreated StockMovement[]     @relation("StockMovementCreatedBy")
  salesCreated          Sale[]              @relation("SaleCreatedBy")
  tradeInsCreated       TradeIn[]           @relation("TradeInCreatedBy")
  auditLogs             AuditLog[]
  cashSessionsOpened    CashSession[]       @relation("CashSessionOpenedBy")
  cashSessionsClosed    CashSession[]       @relation("CashSessionClosedBy")
  conversations         AiConversation[]
  sessions              Session[]
  accounts              Account[]
  verifications         Verification[]
  inAppNotifications    InAppNotification[]
  returnClaimsOpened    ReturnClaim[]       @relation("ReturnClaimOpenedBy")
  returnClaimsResolved  ReturnClaim[]       @relation("ReturnClaimResolvedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// ACCOUNT (Better Auth — OAuth/social accounts)
// ─────────────────────────────────────────────

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model Customer {
  id                String    @id @default(cuid())
  name              String
  phone             String    @unique
  email             String?
  // WhatsApp status updates are only sent when the customer opted in.
  whatsappConsent   Boolean   @default(false)
  whatsappConsentAt DateTime? @db.Timestamptz
  // Last proactive remarketing send (Pro module "remarketing") — the
  // cooldown between sends is measured from this timestamp.
  lastRemarketingAt DateTime? @db.Timestamptz
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  jobs  Job[]
  sales Sale[]

  tradeIns TradeIn[]

  @@index([email])
  @@map("customers")
}

// ─────────────────────────────────────────────
// DEVICE
// Color removed from Device — moved to Job.
// ─────────────────────────────────────────────

model Device {
  id        String   @id @default(cuid())
  brandId   String
  model     String
  category  String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  jobs  Job[]

  @@unique([brandId, model])
  @@index([brandId])
  @@map("devices")
}

// ─────────────────────────────────────────────
// BRAND
// ─────────────────────────────────────────────

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  devices Device[]

  @@map("brands")
}

// ─────────────────────────────────────────────
// JOB COUNTER
// year is the natural key. Use serializable $transaction
// when incrementing lastSeq to prevent race conditions.
// @@unique([year]) constraint provides a safety net.
// ─────────────────────────────────────────────

model JobCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("job_counters")
}

// ─────────────────────────────────────────────────
// SALE COUNTER (POS)
// year is the natural key; sequential SALE codes.
// ─────────────────────────────────────────────────

model SaleCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("sale_counters")
}

// ─────────────────────────────────────────────────
// SALE (POS — counter sales without a repair job)
// Items and payments are snapshotted at checkout.
// total = sum(lineTotal of items); payments are the
// applied amounts and must sum to total.
// ─────────────────────────────────────────────────

model Sale {
  id       String @id @default(cuid())
  saleCode String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  total Decimal @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  items    SaleItem[]
  payments SalePayment[]

  @@index([createdAt])
  @@index([customerId])
  @@index([createdById])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  partId String?
  part   PartsCatalog? @relation(fields: [partId], references: [id], onDelete: SetNull)

  // Snapshotted at checkout.
  name      String
  category  PartCategory
  unitPrice Decimal      @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal      @db.Decimal(10, 2)

  @@index([saleId])
  @@index([partId])
  @@map("sale_items")
}

model SalePayment {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now()) @db.Timestamptz

  @@index([saleId])
  @@map("sale_payments")
}

// ─────────────────────────────────────────────
// JOB
// estimatedCost is required per PRD intake form.
// finalCost is computed on read: Sum(JobRepair.price) + Sum(JobPart.totalCost).
// accessCode should be generated with crypto.randomBytes(8).toString('hex').
// ─────────────────────────────────────────────

model Job {
  id         String @id @default(cuid())
  jobCode    String @unique
  accessCode String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  deviceId String
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  color    String?
  // IMEI/serial captured at intake (nullable — shops may not always record it).
  // 15 digits for IMEI; VarChar(16) tolerates 16-digit MEID with check digit.
  imei     String? @db.VarChar(16)

  reportedProblem String    @db.Text
  conditionNotes  String?   @db.Text
  // Unlock PIN/pattern collected at intake so the technician can test the device.
  deviceUnlockCode String?
  // Accessories handed in with the device (charger, case, SIM, box...).
  accessories      String[] @default([])
  // Intake functional checklist: {key: "ok"|"fail"|null} — null = not tested.
  intakeChecklist  Json?
  // Customer signature captured at intake (PNG data URL) — printed on the
  // receipt as proof the customer accepted the repair terms.
  intakeSignatureDataUrl String? @db.Text
  // Post-repair QC checklist captured when marking the job DONE
  // ({key: "ok"|"fail"}) — mirrors intakeChecklist.
  qcChecklist Json?
  // Urgent flag — customer waiting / priority queue. Surfaced as a badge.
  isUrgent               Boolean   @default(false)
  status                 JobStatus @default(INTAKE)

  estimatedCost Decimal  @db.Decimal(10, 2)
  depositAmount Decimal? @db.Decimal(10, 2)

  estimatedDate DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  actualLaborHours Decimal? @db.Decimal(10, 2)
  holdReason       String?  @db.Text

  // One-click "paid on delivery": method chosen when marking (null = not
  // marked); the Payment row is created automatically on DELIVERED.
  paymentOnDeliveryMethod String?

  lastOverdueAlertAt DateTime? @db.Timestamptz

  isWarrantyReturn Boolean @default(false)
  // Public portal link published to OficinaOS Cloud (module: portal).
  // accessCode is the unguessable token in the public URL.
  portalPublishedAt DateTime? @db.Timestamptz
  warrantyForJobId String?
  warrantyForJob   Job?    @relation("WarrantyReturn", fields: [warrantyForJobId], references: [id], onDelete: SetNull)
  warrantyReturns  Job[]   @relation("WarrantyReturn")

  createdById String
  createdBy   User    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation("AssignedTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  photos             JobPhoto[]
  notes              JobNote[]
  payments           Payment[]
  quotes             JobQuote[]
  partsUsed          JobPart[]
  partsWaiting       JobPartsWaiting[]
  repairs            JobRepair[]
  auditLogs          AuditLog[]
  notifications      NotificationOutbox[]
  inAppNotifications InAppNotification[]

  // ── Return claims ────────────────────────────────────────────────────
  returnClaimsAgainst ReturnClaim[] @relation("OriginalJobReturnClaims")
  reworkClaim         ReturnClaim?  @relation("ReworkJobReturnClaim")

  intakeRequests IntakeRequest[]

  @@index([customerId])
  @@index([deviceId])
  @@index([status])
  @@index([technicianId])
  @@index([createdById])
  @@index([warrantyForJobId])
  @@index([accessCode])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, estimatedDate])
  @@index([imei])
  @@map("jobs")
}

// ─────────────────────────────────────────────
// INTAKE REQUEST (public pre-check / pre-triage)
// Created by the unauthenticated /pre-check form — later also by the
// hosted Pro relay for inbound WhatsApp. Staff reviews and converts
// each request into a Job; status never lets a request be converted
// twice.
// ─────────────────────────────────────────────

model IntakeRequestCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("intake_request_counters")
}

enum IntakeRequestStatus {
  PENDING
  CONVERTED
  DISMISSED
}

model IntakeRequest {
  id            String              @id @default(cuid())
  code          String              @unique
  // Diagnostics pushed by the cloud diag-intake module: externalId is the
  // cloud IntakeReport id and dedupes redelivery after a partial failure.
  externalId    String?             @unique
  diagnostic    Json?
  // AI report attached to the diagnostic — either generated in the diag tool
  // and sent with it, or generated on demand by the shop via cloud ai-reports.
  aiReport      String?             @db.Text
  customerName  String
  customerPhone String
  customerEmail String?
  deviceLabel   String
  problem       String              @db.Text
  whatsappOptIn Boolean             @default(false)
  // Optional appointment the customer asked for on the public form — a
  // request, not a confirmed booking; staff confirms by phone.
  scheduledFor  DateTime?           @db.Timestamptz
  status        IntakeRequestStatus @default(PENDING)
  jobId         String?
  job           Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now()) @db.Timestamptz
  updatedAt     DateTime            @updatedAt @db.Timestamptz

  @@index([status, createdAt])
  @@map("intake_requests")
}

// ─────────────────────────────────────────────
// JOB QUOTES
// Versioned customer-facing quotes sent for approval on the public
// tracking page. Sending a new quote supersedes the previous SENT one
// (rejection → revise → resend v2). status transitions:
//   SENT -> APPROVED | REJECTED | SUPERSEDED
// ─────────────────────────────────────────────

model JobQuote {
  id           String      @id @default(cuid())
  jobId        String
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  version      Int
  amount       Decimal     @db.Decimal(10, 2)
  note         String?     @db.Text
  status       QuoteStatus @default(SENT)
  sentAt       DateTime    @default(now()) @db.Timestamptz
  respondedAt  DateTime?   @db.Timestamptz
  responseNote String?     @db.Text

  @@unique([jobId, version])
  @@index([jobId])
  @@map("job_quotes")
}

// ─────────────────────────────────────────────
// JOB PHOTOS
// Max 5 per job enforced via DB trigger (see migration).
// path points to file on local VPS disk.
// ─────────────────────────────────────────────

model JobPhoto {
  id            String       @id @default(cuid())
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  path          String
  stage         PhotoStage? // null = legacy/general
  returnClaimId String?
  returnClaim   ReturnClaim? @relation(fields: [returnClaimId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @db.Timestamptz

  @@index([jobId])
  @@index([returnClaimId])
  @@map("job_photos")
}

// ─────────────────────────────────────────────
// JOB NOTES
// ─────────────────────────────────────────────

model JobNote {
  id                String   @id @default(cuid())
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content           String   @db.Text
  isCustomerVisible Boolean  @default(false)
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now()) @db.Timestamptz

  @@index([jobId, isCustomerVisible])
  @@map("job_notes")
}

// ─────────────────────────────────────────────
// JOB PARTS WAITING
// ─────────────────────────────────────────────

model JobPartsWaiting {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partName  String
  supplier  String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([jobId])
  @@map("job_parts_waiting")
}

// ─────────────────────────────────────────────
// PARTS CATALOG
// ─────────────────────────────────────────────

model PartsCatalog {
  id                  String       @id @default(cuid())
  name                String
  category            PartCategory
  defaultPrice        Decimal      @db.Decimal(10, 2)
  supplier            String?
  stockQuantity       Int          @default(0)
  reorderLevel        Int          @default(0)
  isActive            Boolean      @default(true)
  // Pro module "storefront" — public on the shop's online store page.
  listedOnline          Boolean      @default(false)
  // Set when an OWNER low-stock alert fires; gates re-alerts (24h window).
  lastLowStockAlertAt DateTime?    @db.Timestamptz
  createdAt           DateTime     @default(now()) @db.Timestamptz
  updatedAt           DateTime     @updatedAt @db.Timestamptz

  jobParts       JobPart[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([category])
  @@map("parts_catalog")
}

// ─────────────────────────────────────────────
// JOB PARTS (CONSUMED)
// All fields are snapshotted at time of use.
// partId is nullable to support ad-hoc parts.
// ─────────────────────────────────────────────

model JobPart {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  partId String?
  part   PartsCatalog? @relation(fields: [partId], references: [id], onDelete: SetNull)

  partName  String
  category  PartCategory
  unitPrice Decimal      @db.Decimal(10, 2)
  quantity  Int          @default(1)
  supplier  String?
  totalCost Decimal      @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  returnClaims ReturnClaim[]

  @@index([jobId])
  @@map("job_parts")
}

// ─────────────────────────────────────────────
// STOCK MOVEMENTS
// Append-only ledger of every stock change: PURCHASE (manual intake),
// CONSUMPTION (job part usage), RETURN (line removal restores stock)
// and ADJUSTMENT (manual correction). quantity is the signed delta;
// balanceAfter snapshots the part stock right after the movement.
// ─────────────────────────────────────────────

model StockMovement {
  id     String       @id @default(cuid())
  partId String
  part   PartsCatalog @relation(fields: [partId], references: [id], onDelete: Restrict)

  type         MovementType
  quantity     Int // signed delta: positive in, negative out
  balanceAfter Int
  unitCost     Decimal?     @db.Decimal(10, 2)
  supplier     String?
  reference    String?
  note         String?      @db.Text

  createdById String
  createdBy   User     @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([partId, createdAt])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────
// REPAIR CATALOG
// ─────────────────────────────────────────────

model RepairCatalog {
  id           String         @id @default(cuid())
  name         String         @unique
  category     RepairCategory
  defaultPrice Decimal        @db.Decimal(10, 2)
  isActive     Boolean        @default(true)
  warrantyDays Int? // null = inherit ShopSettings.defaultWarrantyDays
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  jobRepairs JobRepair[]

  @@map("repair_catalog")
}

// ─────────────────────────────────────────────
// JOB REPAIRS (PERFORMED)
// All fields are snapshotted at time of use.
// repairId is nullable to support ad-hoc repairs.
// ─────────────────────────────────────────────

model JobRepair {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  repairId String?
  repair   RepairCatalog? @relation(fields: [repairId], references: [id], onDelete: SetNull)

  repairName String
  category   RepairCategory
  price      Decimal        @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  returnClaims ReturnClaim[]

  @@unique([jobId, repairId])
  @@index([jobId])
  @@map("job_repairs")
}

// ─────────────────────────────────────────────
// PAYMENTS
// Multiple partial payments per job; job balance due is
// computed as (parts + repairs) - deposit - sum(payments.amount).
// amount snapshotted at time of recording.
// ─────────────────────────────────────────────

model Payment {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  note      String?       @db.Text

  createdById String
  createdBy   User     @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([jobId])
  @@index([jobId, createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────
// RETURN CLAIMS
// A claim is a customer's complaint about a delivered repair.
// Lifecycle: OPEN -> RESOLVED. Resolution outcomes:
//   REWORK_FREE / REWORK_PARTIAL_CHARGE -> spawns rework Job (reworkJobId set)
//   REFUND_PARTIAL / REFUND_FULL -> no Job spawned, refundAmount set
// ─────────────────────────────────────────────

model ReturnClaim {
  id String @id @default(cuid())

  originalJobId String
  originalJob   Job    @relation("OriginalJobReturnClaims", fields: [originalJobId], references: [id], onDelete: Restrict)

  claimedJobRepairId String?
  claimedJobRepair   JobRepair? @relation(fields: [claimedJobRepairId], references: [id], onDelete: SetNull)

  claimedJobPartId String?
  claimedJobPart   JobPart? @relation(fields: [claimedJobPartId], references: [id], onDelete: SetNull)

  returnReason String @db.Text

  faultCategory       FaultCategory?
  resolutionOutcome   ResolutionOutcome?
  partialChargeAmount Decimal?           @db.Decimal(10, 2)
  refundAmount        Decimal?           @db.Decimal(10, 2)

  reworkJobId String? @unique
  reworkJob   Job?    @relation("ReworkJobReturnClaim", fields: [reworkJobId], references: [id], onDelete: SetNull)

  status     ReturnClaimStatus @default(OPEN)
  openedAt   DateTime          @default(now()) @db.Timestamptz
  resolvedAt DateTime?         @db.Timestamptz

  openedById   String
  openedBy     User    @relation("ReturnClaimOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedById String?
  resolvedBy   User?   @relation("ReturnClaimResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  photos JobPhoto[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([originalJobId])
  @@index([status])
  @@index([faultCategory])
  @@index([resolutionOutcome])
  @@index([openedAt])
  @@index([openedById])
  @@map("return_claims")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// Audit logs survive job deletion (Restrict, not Cascade).
// metadata holds structured payload (enums, IDs).
// fromValue/toValue are human-readable display strings.
// ─────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  jobId     String?
  job       Job?        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    AuditAction
  fromValue String?     @db.Text
  toValue   String?     @db.Text
  note      String?     @db.Text
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([jobId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// NOTIFICATION TEMPLATES
// ─────────────────────────────────────────────

model NotificationTemplate {
  id        String        @id @default(cuid())
  name      String
  channel   NotifyChannel
  body      String        @db.Text
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  @@unique([name, channel])
  @@index([channel])
  @@map("notification_templates")
}

// ─────────────────────────────────────────────
// NOTIFICATION OUTBOX
// ─────────────────────────────────────────────

model NotificationOutbox {
  id             String        @id @default(cuid())
  jobId          String?
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  templateName   String
  channel        NotifyChannel
  recipientPhone String
  renderedBody   String        @db.Text
  status         OutboxStatus  @default(QUEUED)
  error          String?       @db.Text
  retryCount     Int           @default(0)
  nextRetryAt    DateTime?     @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz
  sentAt         DateTime?     @db.Timestamptz

