// ─────────────────────────────────────────────
// SHOP SETTINGS (single row)
// Fixed id for single-row upsert pattern.
// ─────────────────────────────────────────────

model ShopSettings {
  id                        String   @id
  shopName                  String   @default("")
  logoPath                  String?
  address                   String?
  phone                     String?
  countryCode               String   @default("PT")
  currency                  String   @default("EUR")
  defaultWarrantyDays       Int      @default(30)
  timezone                  String? // IANA name, e.g. "Africa/Algiers". Null -> env TZ fallback.
  receiptFooter             String?  @db.Text
  // Printing — presets applied by the server-rendered receipt/label HTML.
  // receiptPaper: "58mm" | "80mm" (thermal roll) | "a4" (full document).
  receiptPaper              String   @default("80mm")
  receiptShowImei           Boolean  @default(true)
  receiptShowProblem        Boolean  @default(true)
  receiptShowSignature      Boolean  @default(true)
  receiptShowQr             Boolean  @default(true)
  receiptShowWarranty       Boolean  @default(true)
  // Job label sheet size: "40x20" | "57x32" | "62x29" (mm).
  labelSize                 String   @default("40x20")
  // Direct network printing: "browser" (OS print dialog, any printer) or
  // "escpos" (server sends ESC/POS over TCP to printerHost:printerPort).
  printerMode               String   @default("browser")
  printerHost               String?
  printerPort               Int      @default(9100)
  // Meta mensal de faturação — progresso mostrado no dashboard do gerente.
  // Null = sem meta definida (não mostrar nada).
  monthlyRevenueGoal        Decimal? @db.Decimal(10, 2)
  whatsappApiTokenEncrypted String?
  whatsappBusinessId        String?
  whatsappPhoneNumberId     String?
  whatsappEnabled           Boolean  @default(false)
  // Remarketing automático (Pro module "remarketing") — proactive WhatsApp
  // re-engagement for customers idle for remarketingDays, throttled by a
  // cooldown and sent as a Meta-approved template message.
  remarketingEnabled        Boolean  @default(false)
  remarketingDays           Int      @default(90)
  remarketingCooldownDays   Int      @default(180)
  remarketingTemplate       String?
  // Public base URL used to build customer-facing links (e.g. WhatsApp
  // tracking links). Optional: shops on a LAN may not expose one.
  trackingBaseUrl           String?
  // Public review link (e.g. Google Business "write a review" URL) shown on
  // the tracking page after delivery and in the delivered notification.
  reviewUrl                 String?
  // OficinaOS Cloud pairing — Pro modules live server-side; the shop token
  // is stored encrypted like the AI key. Entitlements are cached and polled.
  cloudApiUrl               String?
  cloudShopTokenEncrypted   String?
  cloudShopId               String?
  cloudShopName             String?
  cloudEntitlements         Json?
  cloudSyncedAt             DateTime? @db.Timestamptz
  // Loja online (Pro module "storefront") — public page on the cloud.
  storePublished            Boolean  @default(false)
  storeDescription          String?  @db.Text
  storeSlug                 String?
  storeEmail                String?
  // Push to the cloud on the next entitlement sync when true.
  storeDirty                Boolean  @default(true)
  // Storefront+ (Pro module "storefront-plus") — paid store theme.
  storeAccentColor          String?
  storeTemplate             String?
  // Shop logo as a data URL (≤~280KB); pushed to the cloud on sync.
  storeLogoData             String?  @db.Text
  // Preços de mercado (Pro module "market-prices") — anonymous opt-in
  // contribution of catalog prices to the cloud aggregate.
  sharePrices               Boolean  @default(false)
  // Push the price snapshot on the next entitlement sync when true.
  pricesDirty               Boolean  @default(true)
  createdAt                 DateTime @default(now()) @db.Timestamptz
  updatedAt                 DateTime @updatedAt @db.Timestamptz

  @@map("shop_settings")
}

// ─────────────────────────────────────────────
// CASH SESSION (formal daily cash-up)
// One OPEN session per shop-local day. The report figures are snapshotted at
// close time so later backdated payments never rewrite history. Counted cash
// is entered by the cashier; countedTotalCollected may be signed for the
// paper audit trail. Divergence = countedCash − systemCash.
// ─────────────────────────────────────────────

model CashSession {
  id          String           @id @default(cuid())
  day         DateTime         @db.Timestamptz
  timezone    String
  status      CashSessionStatus @default(OPEN)

  report               Json
  countedCash          Decimal?  @db.Decimal(10, 2)
  countedNonCash       Decimal?  @db.Decimal(10, 2)
  countedTotalCollected Decimal? @db.Decimal(10, 2)
  cashDivergence       Decimal?  @db.Decimal(10, 2)
  note                 String?   @db.Text
  signatureDataUrl     String?   @db.Text

  openedById  String
  openedBy    User     @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt    DateTime @default(now()) @db.Timestamptz

  closedById  String?
  closedBy    User?    @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  closedAt    DateTime? @db.Timestamptz
  reopenCount Int      @default(0)

  @@unique([day, timezone])
  @@index([status])
  @@index([day])
  @@map("cash_sessions")
}

// ─────────────────────────────────────────────
// SESSION (Better Auth)
// ─────────────────────────────────────────────

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime @db.Timestamptz
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// TRADE-INS (compra de usados / retoma)
// The shop buys a used device from a customer. Portuguese law requires a
// register of second-hand goods purchases identifying the seller — the
// sellerIdType/sellerIdNumber fields are that legal record, and the signed
// receipt is the proof. Status flow:
//   OFFERED -> PURCHASED | CANCELLED ; PURCHASED -> SOLD
// ─────────────────────────────────────────────

enum TradeInStatus {
  OFFERED
  PURCHASED
  CANCELLED
  SOLD
}

enum TradeInCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum TradeInPaymentMethod {
  CASH
  TRANSFER
  STORE_CREDIT
}

model TradeInCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("trade_in_counters")
}

model TradeIn {
  id                  String                @id @default(cuid())
  code                String                @unique
  customerId          String
  customer            Customer              @relation(fields: [customerId], references: [id])
  // Registo legal de bens em 2ª mão — identificação do vendedor.
  sellerIdType        String
  sellerIdNumber      String
  deviceBrand         String
  deviceModel         String
  imei                String?
  storage             String?
  condition           TradeInCondition
  functionalChecklist Json?
  notes               String?               @db.Text
  purchasePrice       Decimal               @db.Decimal(10, 2)
  paymentMethod       TradeInPaymentMethod
  status              TradeInStatus         @default(OFFERED)
  signatureDataUrl    String?               @db.Text
  createdById         String?
  createdBy           User?                 @relation("TradeInCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now()) @db.Timestamptz
  updatedAt           DateTime              @updatedAt @db.Timestamptz

  @@index([status, createdAt])
  @@map("trade_ins")
}

// ─────────────────────────────────────────────
// VERIFICATION (Better Auth)
// ─────────────────────────────────────────────

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @db.Timestamptz

  @@index([identifier])
  @@index([userId])
  @@map("verifications")
}
