// Reparilo — Prisma Schema
// Version: 4.0 — Production-ready
// Database: PostgreSQL 17
// All DateTime fields use @db.Timestamptz for timezone safety.
// CHECK constraints, triggers, and partial indexes applied via migrations.

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  OWNER
  TECHNICIAN
  FRONT_DESK
}

enum JobStatus {
  INTAKE
  WAITING_FOR_PARTS
  IN_REPAIR
  ON_HOLD
  DONE
  DELIVERED
  RETURNED
  CANCELLED
}

enum PartCategory {
  SCREEN
  BATTERY
  CHARGING_PORT
  CAMERA
  SPEAKER
  MICROPHONE
  MOTHERBOARD
  HOUSING
  BUTTON
  OTHER
}

enum FaultCategory {
  WORKMANSHIP
  DEFECTIVE_PART
  MISDIAGNOSIS
}

enum ResolutionOutcome {
  REWORK_FREE
  REWORK_PARTIAL_CHARGE
  REFUND_PARTIAL
  REFUND_FULL
}

enum ReturnClaimStatus {
  OPEN
  RESOLVED
}

enum PhotoStage {
  RETURN_INTAKE
  RETURN_RESOLUTION
}

enum RepairCategory {
  HARDWARE
  SOFTWARE
  DIAGNOSTIC
  OTHER
}

enum NotifyChannel {
  WHATSAPP
  IN_APP
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum AuditAction {
  JOB_CREATED
  STATUS_CHANGED
  TECHNICIAN_ASSIGNED
  COST_UPDATED
  PART_ADDED
  PART_REMOVED
  REPAIR_ADDED
  REPAIR_REMOVED
  NOTE_ADDED
  PHOTO_ADDED
  PHOTO_REMOVED
  JOB_UPDATED
  WARRANTY_RETURN_CREATED
  NOTIFICATION_SENT
  USER_SIGN_IN
  USER_SIGN_OUT
  USER_CREATED
  PASSWORD_RESET
  API_MUTATION
}

enum AiRole {
  USER
  ASSISTANT
}

enum AiMessageFeedback {
  THUMBS_UP
  THUMBS_DOWN
}

// ─────────────────────────────────────────────
// USER
// password stores Argon2id hash (~97 chars).
// email is required and unique for account identification.
// Auth is username + password via Better Auth.
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  name                String    @default("")
  username            String    @unique
  displayUsername     String?
  email               String    @unique
  emailVerified       Boolean   @default(false)
  image               String?
  password            String?
  role                Role
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  assignedJobs         Job[]               @relation("AssignedTechnician")
  createdJobs          Job[]               @relation("CreatedBy")
  updatedJobs          Job[]               @relation("UpdatedBy")
  notes                JobNote[]
  jobParts             JobPart[]
  jobRepairs           JobRepair[]
  auditLogs            AuditLog[]
  conversations        AiConversation[]
  sessions             Session[]
  accounts             Account[]
  verifications        Verification[]
  inAppNotifications   InAppNotification[]
  returnClaimsOpened   ReturnClaim[]       @relation("ReturnClaimOpenedBy")
  returnClaimsResolved ReturnClaim[]       @relation("ReturnClaimResolvedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// ACCOUNT (Better Auth — OAuth/social accounts)
// ─────────────────────────────────────────────

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  jobs Job[]

  @@index([email])
  @@map("customers")
}

// ─────────────────────────────────────────────
// DEVICE
// Color removed from Device — moved to Job.
// ─────────────────────────────────────────────

model Device {
  id        String   @id @default(cuid())
  brandId   String
  model     String
  category  String?
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  jobs  Job[]

  @@unique([brandId, model])
  @@index([brandId])
  @@map("devices")
}

// ─────────────────────────────────────────────
// BRAND
// ─────────────────────────────────────────────

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  devices Device[]

  @@map("brands")
}

// ─────────────────────────────────────────────
// JOB COUNTER
// year is the natural key. Use serializable $transaction
// when incrementing lastSeq to prevent race conditions.
// @@unique([year]) constraint provides a safety net.
// ─────────────────────────────────────────────

model JobCounter {
  year    Int @id
  lastSeq Int @default(0)

  @@map("job_counters")
}

// ─────────────────────────────────────────────
// JOB
// estimatedCost is required per PRD intake form.
// finalCost is computed on read: Sum(JobRepair.price) + Sum(JobPart.totalCost).
// accessCode should be generated with crypto.randomBytes(8).toString('hex').
// ─────────────────────────────────────────────

model Job {
  id         String @id @default(cuid())
  jobCode    String @unique
  accessCode String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  deviceId String
  device   Device  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  color    String?
  // IMEI/serial captured at intake (nullable — shops may not always record it).
  // 15 digits for IMEI; VarChar(16) tolerates 16-digit MEID with check digit.
  imei     String? @db.VarChar(16)

  reportedProblem String    @db.Text
  conditionNotes  String?   @db.Text
  status          JobStatus @default(INTAKE)

  estimatedCost Decimal  @db.Decimal(10, 2)
  depositAmount Decimal? @db.Decimal(10, 2)

  estimatedDate DateTime? @db.Date
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  actualLaborHours Decimal? @db.Decimal(10, 2)
  holdReason       String?  @db.Text

  lastOverdueAlertAt DateTime? @db.Timestamptz

  isWarrantyReturn Boolean @default(false)
  warrantyForJobId String?
  warrantyForJob   Job?    @relation("WarrantyReturn", fields: [warrantyForJobId], references: [id], onDelete: SetNull)
  warrantyReturns  Job[]   @relation("WarrantyReturn")

  createdById String
  createdBy   User    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?   @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  technicianId String?
  technician   User?   @relation("AssignedTechnician", fields: [technicianId], references: [id], onDelete: SetNull)

  photos             JobPhoto[]
  notes              JobNote[]
  partsUsed          JobPart[]
  partsWaiting       JobPartsWaiting[]
  repairs            JobRepair[]
  auditLogs          AuditLog[]
  notifications      NotificationOutbox[]
  inAppNotifications InAppNotification[]

  // ── Return claims ────────────────────────────────────────────────────
  returnClaimsAgainst ReturnClaim[] @relation("OriginalJobReturnClaims")
  reworkClaim         ReturnClaim?  @relation("ReworkJobReturnClaim")

  @@index([customerId])
  @@index([deviceId])
  @@index([status])
  @@index([technicianId])
  @@index([createdById])
  @@index([warrantyForJobId])
  @@index([accessCode])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, estimatedDate])
  @@index([imei])
  @@map("jobs")
}

// ─────────────────────────────────────────────
// JOB PHOTOS
// Max 5 per job enforced via DB trigger (see migration).
// path points to file on local VPS disk.
// ─────────────────────────────────────────────

model JobPhoto {
  id            String       @id @default(cuid())
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  path          String
  stage         PhotoStage? // null = legacy/general
  returnClaimId String?
  returnClaim   ReturnClaim? @relation(fields: [returnClaimId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @db.Timestamptz

  @@index([jobId])
  @@index([returnClaimId])
  @@map("job_photos")
}

// ─────────────────────────────────────────────
// JOB NOTES
// ─────────────────────────────────────────────

model JobNote {
  id                String   @id @default(cuid())
  jobId             String
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content           String   @db.Text
  isCustomerVisible Boolean  @default(false)
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now()) @db.Timestamptz

  @@index([jobId, isCustomerVisible])
  @@map("job_notes")
}

// ─────────────────────────────────────────────
// JOB PARTS WAITING
// ─────────────────────────────────────────────

model JobPartsWaiting {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partName  String
  supplier  String?
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([jobId])
  @@map("job_parts_waiting")
}

// ─────────────────────────────────────────────
// PARTS CATALOG
// ─────────────────────────────────────────────

model PartsCatalog {
  id            String       @id @default(cuid())
  name          String
  category      PartCategory
  defaultPrice  Decimal      @db.Decimal(10, 2)
  supplier      String?
  stockQuantity Int          @default(0)
  reorderLevel  Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz
  updatedAt     DateTime     @updatedAt @db.Timestamptz

  jobParts JobPart[]

  @@index([name])
  @@index([category])
  @@map("parts_catalog")
}

// ─────────────────────────────────────────────
// JOB PARTS (CONSUMED)
// All fields are snapshotted at time of use.
// partId is nullable to support ad-hoc parts.
// ─────────────────────────────────────────────

model JobPart {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  partId String?
  part   PartsCatalog? @relation(fields: [partId], references: [id], onDelete: SetNull)

  partName  String
  category  PartCategory
  unitPrice Decimal      @db.Decimal(10, 2)
  quantity  Int          @default(1)
  supplier  String?
  totalCost Decimal      @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  returnClaims ReturnClaim[]

  @@index([jobId])
  @@map("job_parts")
}

// ─────────────────────────────────────────────
// REPAIR CATALOG
// ─────────────────────────────────────────────

model RepairCatalog {
  id           String         @id @default(cuid())
  name         String         @unique
  category     RepairCategory
  defaultPrice Decimal        @db.Decimal(10, 2)
  isActive     Boolean        @default(true)
  warrantyDays Int? // null = inherit ShopSettings.defaultWarrantyDays
  createdAt    DateTime       @default(now()) @db.Timestamptz
  updatedAt    DateTime       @updatedAt @db.Timestamptz

  jobRepairs JobRepair[]

  @@map("repair_catalog")
}

// ─────────────────────────────────────────────
// JOB REPAIRS (PERFORMED)
// All fields are snapshotted at time of use.
// repairId is nullable to support ad-hoc repairs.
// ─────────────────────────────────────────────

model JobRepair {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  repairId String?
  repair   RepairCatalog? @relation(fields: [repairId], references: [id], onDelete: SetNull)

  repairName String
  category   RepairCategory
  price      Decimal        @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @db.Timestamptz

  returnClaims ReturnClaim[]

  @@unique([jobId, repairId])
  @@index([jobId])
  @@map("job_repairs")
}

// ─────────────────────────────────────────────
// RETURN CLAIMS
// A claim is a customer's complaint about a delivered repair.
// Lifecycle: OPEN -> RESOLVED. Resolution outcomes:
//   REWORK_FREE / REWORK_PARTIAL_CHARGE -> spawns rework Job (reworkJobId set)
//   REFUND_PARTIAL / REFUND_FULL -> no Job spawned, refundAmount set
// ─────────────────────────────────────────────

model ReturnClaim {
  id String @id @default(cuid())

  originalJobId String
  originalJob   Job    @relation("OriginalJobReturnClaims", fields: [originalJobId], references: [id], onDelete: Restrict)

  claimedJobRepairId String?
  claimedJobRepair   JobRepair? @relation(fields: [claimedJobRepairId], references: [id], onDelete: SetNull)

  claimedJobPartId String?
  claimedJobPart   JobPart? @relation(fields: [claimedJobPartId], references: [id], onDelete: SetNull)

  returnReason String @db.Text

  faultCategory       FaultCategory?
  resolutionOutcome   ResolutionOutcome?
  partialChargeAmount Decimal?           @db.Decimal(10, 2)
  refundAmount        Decimal?           @db.Decimal(10, 2)

  reworkJobId String? @unique
  reworkJob   Job?    @relation("ReworkJobReturnClaim", fields: [reworkJobId], references: [id], onDelete: SetNull)

  status     ReturnClaimStatus @default(OPEN)
  openedAt   DateTime          @default(now()) @db.Timestamptz
  resolvedAt DateTime?         @db.Timestamptz

  openedById   String
  openedBy     User    @relation("ReturnClaimOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedById String?
  resolvedBy   User?   @relation("ReturnClaimResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  photos JobPhoto[]

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@index([originalJobId])
  @@index([status])
  @@index([faultCategory])
  @@index([resolutionOutcome])
  @@index([openedAt])
  @@index([openedById])
  @@map("return_claims")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// Audit logs survive job deletion (Restrict, not Cascade).
// metadata holds structured payload (enums, IDs).
// fromValue/toValue are human-readable display strings.
// ─────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  jobId     String?
  job       Job?        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    AuditAction
  fromValue String?     @db.Text
  toValue   String?     @db.Text
  note      String?     @db.Text
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([jobId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// NOTIFICATION TEMPLATES
// ─────────────────────────────────────────────

model NotificationTemplate {
  id        String        @id @default(cuid())
  name      String
  channel   NotifyChannel
  body      String        @db.Text
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now()) @db.Timestamptz
  updatedAt DateTime      @updatedAt @db.Timestamptz

  @@unique([name, channel])
  @@index([channel])
  @@map("notification_templates")
}

// ─────────────────────────────────────────────
// NOTIFICATION OUTBOX
// ─────────────────────────────────────────────

model NotificationOutbox {
  id             String        @id @default(cuid())
  jobId          String?
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  templateName   String
  channel        NotifyChannel
  recipientPhone String
  renderedBody   String        @db.Text
  status         OutboxStatus  @default(QUEUED)
  error          String?       @db.Text
  retryCount     Int           @default(0)
  nextRetryAt    DateTime?     @db.Timestamptz
  createdAt      DateTime      @default(now()) @db.Timestamptz
  sentAt         DateTime?     @db.Timestamptz

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("notification_outbox")
}

// ─────────────────────────────────────────────
// IN-APP NOTIFICATIONS
// ─────────────────────────────────────────────

model InAppNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type      String
  message   String    @db.Text
  readAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([userId, readAt])
  @@index([readAt, createdAt])
  @@index([userId, type])
  @@map("in_app_notifications")
}

// ─────────────────────────────────────────────
// AI SETTINGS (single row)
// apiKeyEncrypted: AES-256 encrypted at rest.
// Fixed id for single-row upsert pattern.
// ─────────────────────────────────────────────

model AiSettings {
  id              String   @id
  endpointUrl     String   @default("")
  apiKeyEncrypted String   @default("")
  model           String?
  temperature     Float    @default(0.7)
  enabled         Boolean  @default(false)
  maxTokens       Int?     @default(4096)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  @@map("ai_settings")
}

// ─────────────────────────────────────────────
// AI CONVERSATIONS
// ─────────────────────────────────────────────

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  starred   Boolean     @default(false)
  messages  AiMessage[]
  createdAt DateTime    @default(now()) @db.Timestamptz
  updatedAt DateTime    @updatedAt @db.Timestamptz

  @@index([userId, updatedAt])
  @@index([userId, starred])
  @@map("ai_conversations")
}

model AiMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   AiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiRole
  content        String             @db.Text
  agentName      String?
  toolCalls      Json?
  pinned         Boolean            @default(false)
  feedback       AiMessageFeedback?
  createdAt      DateTime           @default(now()) @db.Timestamptz

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// ─────────────────────────────────────────────
// AI AGENT DEFINITIONS
// ─────────────────────────────────────────────

model AiAgentDefinition {
  id                 String   @id @default(cuid())
  name               String   @unique
  displayName        String
  instructions       String   @default("") @db.Text
  model              String?
  temperature        Float?
  toolNames          String[] @default([])
  handoffKeywords    String[] @default([])
  isActive           Boolean  @default(true)
  isBuiltIn          Boolean  @default(false)
  enabledHostedTools String[] @default([])
  vectorStoreId      String?
  createdAt          DateTime @default(now()) @db.Timestamptz
  updatedAt          DateTime @updatedAt @db.Timestamptz

  @@index([isActive])
  @@map("ai_agent_definitions")
}

// ─────────────────────────────────────────────
// AI MEMORIES
// ─────────────────────────────────────────────

model AiMemory {
  id        String   @id @default(cuid())
  content   String   @db.Text
  tags      String[] @default([])
  source    String   @default("manual")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("ai_memories")
}

// ─────────────────────────────────────────────
// AI INSTRUCTIONS
// ─────────────────────────────────────────────

model AiInstruction {
  id        String   @id @default(cuid())
  content   String   @db.Text
  tags      String[] @default([])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("ai_instructions")
}

// ─────────────────────────────────────────────
// SHOP SETTINGS (single row)
// Fixed id for single-row upsert pattern.
// ─────────────────────────────────────────────

model ShopSettings {
  id                        String   @id
  shopName                  String   @default("")
  logoPath                  String?
  address                   String?
  phone                     String?
  countryCode               String   @default("DZ")
  currency                  String   @default("DZD")
  defaultWarrantyDays       Int      @default(30)
  timezone                  String? // IANA name, e.g. "Africa/Algiers". Null -> env TZ fallback.
  receiptFooter             String?  @db.Text
  whatsappApiTokenEncrypted String?
  whatsappBusinessId        String?
  whatsappPhoneNumberId     String?
  whatsappEnabled           Boolean  @default(false)
  createdAt                 DateTime @default(now()) @db.Timestamptz
  updatedAt                 DateTime @updatedAt @db.Timestamptz

  @@map("shop_settings")
}

// ─────────────────────────────────────────────
// SESSION (Better Auth)
// ─────────────────────────────────────────────

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String   @unique
  expiresAt      DateTime @db.Timestamptz
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// VERIFICATION (Better Auth)
// ─────────────────────────────────────────────

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([identifier])
  @@index([userId])
  @@map("verifications")
}
