FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV HUSKY=0

COPY package.json ./
RUN node -e 'const fs=require("fs"); const p=JSON.parse(fs.readFileSync("package.json","utf8")); for(const [k,v] of Object.entries(p.overrides||{})){for(const group of ["dependencies","devDependencies"]){if(p[group]?.[k]) p[group][k]=v;}} p.devDependencies.tsx="4.20.6"; fs.writeFileSync("package.json",JSON.stringify(p,null,2));'
RUN npm install -g npm@11.19.1
RUN npm install --no-audit --no-fund

COPY . .
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" ./node_modules/.bin/prisma generate
RUN ./node_modules/.bin/vite build

ENV NODE_ENV=production
EXPOSE 4000

CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && exec ./node_modules/.bin/tsx server/index.ts"]
