# ─── Runtime ────────────────────────────────────────────────────────────
# NODE_ENV       — "development" | "test" | "production". Controls: SPA serving,
#                  HSTS/CSP headers, error detail, CSRF cookie security, auth
#                  validation. Defaults to "development". Required in Coolify.
NODE_ENV=development

# PORT           — HTTP port the Fastify server binds to. Default: 4000.
PORT=4000

# HOST           — Bind address. "0.0.0.0" to listen on all interfaces.
HOST=0.0.0.0

# LOG_LEVEL      — "fatal" | "error" | "warn" | "info" | "debug" | "trace".
#                  Production: "info" (or "warn" for less noise).
LOG_LEVEL=info

# TRUST_PROXY    — "true" | "false". Honours X-Forwarded-For when behind a
#                  reverse proxy (Cloudflare Tunnel, Traefik, Coolify).
#                  REQUIRED for public/tunnel deployments — without it every
#                  visitor shares the proxy's IP and rate limits apply to all
#                  of them together. Leave unset on a direct LAN install —
#                  otherwise any client can spoof XFF and bypass rate limits.
# TRUST_PROXY=true

# ─── Database ──────────────────────────────────────────────────────────
# DATABASE_URL    — PostgreSQL connection string. Used by both Prisma and the
#                   pg driver adapter. Required.
#                   Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── Secrets ──────────────────────────────────────────────────────────
# All three must be ≥32 characters. Never use placeholders like "change-me"
# or "example" — the server refuses to start with them.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

# BETTER_AUTH_SECRET — Signs session tokens. Used by Better Auth.
BETTER_AUTH_SECRET=replace-with-a-real-random-secret-at-least-32-chars

# AI_ENCRYPTION_KEY  — AES-256 key for encrypting the AI provider API key at rest.
AI_ENCRYPTION_KEY=replace-with-a-real-random-key-at-least-32-chars

# COOKIE_SECRET    — Signs the CSRF cookie. Required in production (server
#                    refuses boot without it). In dev, falls back to
#                    BETTER_AUTH_SECRET.
# COOKIE_SECRET=replace-with-another-real-random-secret-at-least-32-chars

# ─── URLs ──────────────────────────────────────────────────────────────
# APP_URL   — The single public origin of the app. Used for: CORS origins,
#             Better Auth baseURL, receipt QR codes, tracking links.
#             Required in production (server refuses boot with localhost).
#             The scheme also controls the security posture:
#               https://…  → Secure + SameSite=None cookies, HSTS, upgrade-insecure-requests
#                            (required for the Android Capacitor build)
#               http://…   → Lax cookies without Secure (plain-HTTP LAN, no TLS terminator)
#             Example: https://oficinaos.yourdomain.com
# APP_URL=https://oficinaos.yourdomain.com

# API_URL   — Override if the API is on a different host. Defaults to APP_URL.
#             Rarely needed — the same origin serves both.
# API_URL=https://api.oficinaos.yourdomain.com

# EXTRA_TRUSTED_ORIGINS — Comma-separated extra origins allowed by CORS.
#                         Needed for: Capacitor Android (the WebView origin is
#                         https://localhost — androidScheme is "https" in
#                         capacitor.config.ts), local testing from other
#                         devices, etc.
# EXTRA_TRUSTED_ORIGINS=https://localhost,capacitor://localhost,http://192.168.1.100:5173

# ─── Frontend (build-time only) ────────────────────────────────────────
# VITE_API_BASE_URL — Required for Android builds. Tells the Capacitor WebView
#                     where to find the API. Leave empty in dev (Vite proxy
#                     handles it) and in browser production (same-origin works).
#                     For Android: VITE_API_BASE_URL=https://oficinaos.shop
VITE_API_BASE_URL=

# ─── Seeding ──────────────────────────────────────────────────────────
# SEED_ADMIN_PASSWORD — Password for the initial admin user created by
#                       `bun run db:seed`. Optional — defaults to "braindead".
#                       The app forces a username + password change on first
#                       login, so the default is only a bootstrap credential.
# SEED_ADMIN_PASSWORD=braindead
# SEED_ADMIN_EMAIL — Email for the initial admin user. Optional — defaults to
#                    "admin@oficinaos.local". Set a real address if you want
#                    password-reset emails to reach the admin.
# SEED_ADMIN_EMAIL=admin@oficinaos.local

# ─── Filesystem ────────────────────────────────────────────────────────
# UPLOAD_DIR — Where job photos, avatars, and other uploads are stored.
#              Default: ./uploads (relative to working directory).
#              In Coolify: mount a persistent volume at this path.
UPLOAD_DIR=./uploads

# ─── Email (optional — password reset disabled if unset) ──────────────
# All five must be set together, or none. If any are missing, the password
# reset email flow is silently disabled.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="OficinaOS <noreply@oficinaos.example.com>"

# ─── In-app feedback (optional) ───────────────────────────────────────
# "Reportar problema" in the app creates a GitHub issue automatically.
# GITHUB_FEEDBACK_TOKEN — a fine-grained PAT with Issues:write on the repo
#                         below. If unset, the feature replies 503 and the
#                         UI tells the user to contact the admin instead.
# GITHUB_FEEDBACK_REPO  — "owner/repo" receiving the issues.
# GITHUB_FEEDBACK_TOKEN=github_pat_...
# GITHUB_FEEDBACK_REPO=braindeadpt/OficinaOS

# ─── Timezone (optional) ──────────────────────────────────────────────
# TZ — IANA timezone name (e.g. "Africa/Algiers"). Fallback for the shop
#      timezone setting in the admin panel. If unset, defaults to "UTC".
# TZ=Africa/Algiers

# ─── Off-site backups (optional, db-backup sidecar) ───────────────────
# Second backup destination on any S3-compatible object store via rclone.
# BACKUP_REMOTE_ENABLED=true activates the copy and the weekly restore
# verification; BACKUP_RCLONE_REMOTE is an rclone destination like
# "gcs:bucket-name" or "s3:bucket/prefix". Credentials use rclone's
# env-var config, e.g. for S3:
#   RCLONE_CONFIG_S3_TYPE=s3
#   RCLONE_CONFIG_S3_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_S3_ENDPOINT=...        (for MinIO/Cloudflare R2)
# A failed off-site copy never invalidates the local dump; the weekly
# restore check restores the newest remote dump into a throwaway DB.
# BACKUP_REMOTE_ENABLED=false
# BACKUP_RCLONE_REMOTE=
# RESTORE_CHECK_INTERVAL_DAYS=7

# ─── Remote access (optional, Cloudflare Tunnel) ───────────────────────
# Public HTTPS access without opening router ports — works behind CGNAT.
# Guide: docs/remote-access.md. In short:
#   1. Cloudflare Zero Trust → Networks → Tunnels → create tunnel
#   2. Public hostname (e.g. oficina.example.com) → service http://app:4000
#   3. TUNNEL_TOKEN=<token> here
#   4. docker compose --profile tunnel up -d   (source build)
#      or add "tunnel" to COMPOSE_PROFILES      (installed deployments)
#
# Two ways to configure APP_URL with a tunnel:
#   A) Dual access (recommended): keep APP_URL as the LAN address
#      (http://192.168.x.x:4000) and add the tunnel hostname to
#      EXTRA_TRUSTED_ORIGINS — LAN keeps working without internet,
#      remote access uses https://<hostname>.
#   B) HTTPS-everywhere: APP_URL=https://<hostname> — enables Secure
#      cookies + HSTS, but every device (incl. in-store) must use the
#      public URL, so the app needs internet to log in.
# In both cases set Settings → Shop → Tracking base URL to the public
# hostname so customer links (tracking, quotes, receipts) work remotely.
# TUNNEL_TOKEN=

# ─── Automatic updates (optional, installed deployments) ──────────────
# COMPOSE_PROFILES=auto-update starts a Watchtower sidecar that pulls a new
# app image and restarts it on a cron schedule — only the `app` container is
# auto-updated (label-gated); db and db-backup are never touched. Prisma
# migrations run automatically when the new container starts.
# UPDATE_SCHEDULE — 6-field cron (sec min hour dom mon dow) in TZ.
#   Default "0 30 7 * * *" = 07:30 daily. Pick a time when the PC is ON and
#   the shop is CLOSED — an update means a short restart.
# Rollback path: the daily db-backup dump (14-day retention) plus re-pinning
#   the image tag in docker-compose.app.yml.
# COMPOSE_PROFILES=auto-update
# UPDATE_SCHEDULE=0 30 7 * * *