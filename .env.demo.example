# Demo stack env (compose.demo.yaml). DEMO_MODE refuses to boot if any
# real outbound credential (OPENAI_*, EMAIL_*, WHATSAPP_*, SMTP_*, META_*,
# EVOLUTION_*, OFICINAOS_CLOUD_*) is present — keep this file minimal.

BETTER_AUTH_SECRET=change-me-demo-secret-at-least-32-chars
COOKIE_SECRET=change-me-demo-cookie-secret-32-chars-min
AI_ENCRYPTION_KEY=change-me-demo-ai-key-32-chars-padded-ok

TZ=Europe/Lisbon
