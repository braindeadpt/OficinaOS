# Demo stack env (compose.demo.yaml). DEMO_MODE refuses to boot if any
# real outbound credential is present — by prefix (OPENAI_*, EMAIL_*,
# WHATSAPP_*, SMTP_*, META_*, EVOLUTION_*, OFICINAOS_CLOUD_*, CLOUD_*,
# GITHUB_*, INVOICEXPRESS_*, IX_*, TRADE_*, MARKET_*, S3_*, R2_*, AWS_*,
# BACKUP_*, SEED_ADMIN_*, SETUP_TOKEN) or by suffix (*_TOKEN, *_SECRET,
# *_PASSWORD, *_PASS, *_KEY, *_API_KEY, *_APIKEY, *_CREDENTIALS, *_DSN).
# The only exceptions are the three local-only secrets below — keep this
# file minimal.

BETTER_AUTH_SECRET=change-me-demo-secret-at-least-32-chars
COOKIE_SECRET=change-me-demo-cookie-secret-32-chars-min
AI_ENCRYPTION_KEY=change-me-demo-ai-key-32-chars-padded-ok

TZ=Europe/Lisbon

# Optional — see the proxy note in compose.demo.yaml. Rate limits key on
# CF-Connecting-IP only when the peer is private/edge anyway; set this to
# "true" only if requests can also arrive from public socket IPs AND your
# edge proxy strips/overwrites the header. The origin must never be
# reachable directly from the internet.
# DEMO_TRUST_CF_CONNECTING_IP=true
